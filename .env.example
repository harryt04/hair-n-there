# Public contact links use @hairnthere. A replacement support email is pending.

# Optional PostHog Cloud US project token (public, not a personal API key).
# Production only: explicitly set NEXT_PUBLIC_VERCEL_ENV=production at build time in Coolify.
# Leave unset locally and in previews. No PostHog host variable is needed.
NEXT_PUBLIC_POSTHOG_KEY=

# Server-only Discord webhooks. Preview NEVER falls back to the production webhook.
DISCORD_CONTACT_WEBHOOK_URL=
DISCORD_PREVIEW_WEBHOOK_URL=

# Optional shared rate limiting (recommended for a public deployment).
# Without both, the fallback is process-local and cannot enforce a global limit across processes/replicas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy compatibility names still read by the app; Coolify does not set them.
# Set VERCEL_ENV at build AND runtime; NEXT_PUBLIC_VERCEL_ENV at build time.
# Production: production for both. Preview/staging: preview for both.
# Preview MUST use its own webhook and must not receive production secrets.
# Leave analytics unset locally. Do not set VERCEL (proxy-header detection).
# Never put secrets in NEXT_PUBLIC_*.
VERCEL_ENV=
NEXT_PUBLIC_VERCEL_ENV=

# Optional live @hairnthere feed. Server-only Instagram API with Instagram Login
# user token with instagram_business_basic permission, authorized by @hairnthere.
# Configure at runtime in Coolify; never use NEXT_PUBLIC_* or commit the token.
# Without it, the gallery intentionally stays empty. See README for setup/renewal.
INSTAGRAM_ACCESS_TOKEN=

# Server-only tentative Google Calendar holds. Off unless BOOKING_ENABLED=true
# and OAuth credentials are configured. Runtime in Coolify; see docs/self-scheduling.md.
# Production defaults to primary when GOOGLE_CALENDAR_ID is empty.
# Extra busy calendar IDs are comma-separated; the hold calendar is always checked.
# VERCEL_ENV=preview requires its own GOOGLE_PREVIEW_CALENDAR_ID; no production fallback.
BOOKING_ENABLED=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_BUSY_CALENDAR_IDS=
GOOGLE_PREVIEW_CALENDAR_ID=
GOOGLE_PREVIEW_BUSY_CALENDAR_IDS=

# Development only: synthetic times/in-memory holds; no Google calls or invitations.
# Ignored in production builds. Try: BOOKING_DEMO=true pnpm dev
BOOKING_DEMO=
