# Public contact links use @hairnthere. A replacement support email is pending.

# Optional PostHog Cloud US project token (public, not a personal API key).
# Production only: explicitly set NEXT_PUBLIC_VERCEL_ENV=production at build time in Coolify.
# Leave unset locally and in previews. No PostHog host variable is needed.
NEXT_PUBLIC_POSTHOG_KEY=

# Server-only Discord webhooks. Preview NEVER falls back to the production webhook.
DISCORD_CONTACT_WEBHOOK_URL=
DISCORD_PREVIEW_WEBHOOK_URL=

# Optional shared rate limiting (recommended for a public deployment).
# Without both, the fallback is process-local and cannot enforce a global limit across processes/replicas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy compatibility names still read by the app; Coolify does not set them.
# Set VERCEL_ENV at build AND runtime; NEXT_PUBLIC_VERCEL_ENV at build time.
# Production: production for both. Preview/staging: preview for both.
# Preview MUST use its own webhook and must not receive production secrets.
# Leave analytics unset locally. Do not set VERCEL (proxy-header detection).
# Never put secrets in NEXT_PUBLIC_*.
VERCEL_ENV=
NEXT_PUBLIC_VERCEL_ENV=
