# Public contact links use @hairnthere. A replacement support email is pending.

# Optional PostHog Cloud US project token (public, not a personal API key).
# Production only: requires NEXT_PUBLIC_VERCEL_ENV=production, supplied by Vercel.
# Leave unset locally and in previews. No PostHog host variable is needed.
NEXT_PUBLIC_POSTHOG_KEY=

# Server-only Discord webhooks. Preview NEVER falls back to the production webhook.
DISCORD_CONTACT_WEBHOOK_URL=
DISCORD_PREVIEW_WEBHOOK_URL=

# Optional shared rate limiting (recommended for a public Vercel deployment).
# Without both, the fallback is process-local and cannot enforce a global serverless limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel sets VERCEL_ENV and NEXT_PUBLIC_VERCEL_ENV automatically when system
# environment variables are exposed (project default). Do not put secrets in NEXT_PUBLIC_*.
